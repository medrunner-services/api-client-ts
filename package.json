{
  "name": "@medrunner/api-client",
  "version": "0.7.0",
  "description": "Wrapper library for the Medrunner API",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "tsup",
    "test": "pnpm run build && vitest run",
    "build:docs": "tsc -p tsconfig.docs.json",
    "lint": "eslint src",
    "lint:fix": "pnpm run lint --fix",
    "prettier": "prettier src --check",
    "prettier:fix": "pnpm run prettier --write",
    "check": "pnpm run '/^(lint|prettier)$/'",
    "update-packages": "pnpm ncu"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medrunner-services/api-client-ts.git"
  },
  "contributors": [
    "capitain_obvious <captain@medrunner.dev>",
    "charliefoxtwo <charlie@medrunner.dev>"
  ],
  "license": "GNU General Public License v3.0",
  "bugs": {
    "url": "https://github.com/medrunner-services/api-client-ts/issues"
  },
  "homepage": "https://github.com/medrunner-services/api-client-ts#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "directories": {
    "lib": "src"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@microsoft/signalr": "10.0.0",
    "axios": "1.17.0",
    "openid-client": "6.8.8",
    "qs": "6.15.2",
    "ts-log": "3.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.1",
    "@types/qs": "6.15.1",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "eslint": "10.4.1",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "eslint-plugin-tsdoc": "0.5.2",
    "axios-mock-adapter": "2.1.0",
    "prettier": "3.8.3",
    "tslib": "2.8.1",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
