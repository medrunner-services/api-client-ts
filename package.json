{
  "name": "@medrunner/api-client",
  "version": "0.7.0",
  "description": "Wrapper library for the Medrunner API",
	"packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "tsup",
    "build:docs": "tsc -p tsconfig.docs.json",
    "lint": "pnpx eslint src",
    "lint:fix": "pnpm run lint --fix",
    "prettier": "pnpx prettier src --check",
    "prettier:fix": "pnpm run prettier --write",
		"check": "pnpm run '/(lint|prettier)/'",
		"update-packages": "pnpm ncu"
	},
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medrunner-services/api-client-ts.git"
  },
  "contributors": [
    "capitain_obvious <captain@medrunner.dev>",
    "charliefoxtwo <charlie@medrunner.dev>"
  ],
  "license": "GNU General Public License v3.0",
  "bugs": {
    "url": "https://github.com/medrunner-services/api-client-ts/issues"
  },
  "homepage": "https://github.com/medrunner-services/api-client-ts#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "directories": {
    "lib": "src"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@microsoft/signalr": "10.0.0",
    "axios": "1.13.4",
    "ts-log": "2.2.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.9",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "eslint": "9.39.2",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-tsdoc": "0.5.0",
    "prettier": "3.8.1",
    "tslib": "2.8.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
